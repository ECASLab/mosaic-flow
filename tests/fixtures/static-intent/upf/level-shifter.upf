set_design_top level_shifter_fixture
create_power_domain PD_LS -include_scope
create_supply_port VDD_LOW -domain PD_LS
create_supply_port VDD_HIGH -domain PD_LS
create_supply_port VSS -domain PD_LS
create_supply_net VDD_LOW -domain PD_LS
create_supply_net VDD_HIGH -domain PD_LS
create_supply_net VSS -domain PD_LS
connect_supply_net VDD_LOW -ports VDD_LOW
connect_supply_net VDD_HIGH -ports VDD_HIGH
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_LS -primary_power_net VDD_LOW -primary_ground_net VSS -secondary_power_net VDD_HIGH
set_port_attributes -ports {data_out} -driver_supply VDD_LOW -receiver_supply VDD_HIGH
set_level_shifter LS_OUTPUTS -domain PD_LS -applies_to outputs -rule low_to_high -location self
